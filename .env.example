# ── Telegram Bot ──────────────────────────────
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
ADMIN_ID=123456789

# ── 数据库路径（Railway Volume 挂载）───────────────
DB_PATH=/data/bot.db

# ── 日志级别（DEBUG / INFO / WARNING / ERROR；默认 INFO）─────
LOG_LEVEL=INFO

# ── Web 管理后台（Telegram Mini App）──────────────
# 启用后租户管理员发送 /start 时将看到进入后台的按钮，而非私聊控制面板。
# Telegram 要求 WebApp URL 必须是 HTTPS。
WEBAPP_ENABLED=false
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# 填写外部可访问的 HTTPS 地址，例如：https://mybot.example.com
WEBAPP_URL=
